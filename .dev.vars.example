# Local synthetic Auth registration must match these origins and client IDs.
# Generate once: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep the key stable across restarts; never commit the real value.
MOLIS_CLUB_ACCOUNT_KEY=
MOLIS_CLUB_ACCOUNT_CONFIG='{"applicationId":"molis-club-unified-local-app","redirectUri":"http://127.0.0.1:3000/account/callback","client":{"environmentId":"unified-local","environmentKind":"LOCAL","authOrigin":"http://127.0.0.1:8787","productOrigin":"http://127.0.0.1:3000","clientId":"molis-club-unified-local","policyProfile":"unified-account-v2","redirectAllowlist":["http://127.0.0.1:3000/account/callback"],"deliveryMode":"MOCK","providerMode":"MOCK"}}'
# For real login, match Auth deliveryMode/providerMode as LIVE and use its actual origin.
# See docs/AUTH-SETUP.md; the default above remains isolated MOCK.
# Delivery and Google/GitHub providers are configured in Auth, not Club.
# Former BETTER_AUTH_* and provider credentials do not enable retired /api/auth routes.
