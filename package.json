{
  "name": "molis-club",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:cloudflare": "CLOUDFLARE_DEPLOY=1 vinext build",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node tests/site-http.mjs && node tests/community-http.mjs && node tests/auth-http.mjs",
    "build:folio-preview": "npm run build && node scripts/export-folio-preview.mjs",
    "dates": "node scripts/page-dates.mjs",
    "media": "node scripts/site-media.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.3",
    "better-auth": "^1.7.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "4.133.0"
  },
  "type": "module",
  "description": "molis-club — a community for AI creators, products, and thoughtful feedback",
  "repository": {
    "type": "git",
    "url": "https://github.com/molis-ai/molis-club.git"
  }
}
